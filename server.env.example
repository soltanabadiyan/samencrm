# Copy to server.env (not in git) and fill in. Read by run_all.sh and tools/ (tools/server_env.sh, server_env.mjs).
SSH_TARGET=root@203.0.113.10
SSH_PORT=22
# Host entry of ~/.ssh/config used by tools/get_session.sh and tools/sync_theme.sh (default: SSH_TARGET)
SSH_ALIAS=crm-server
# Address users open in the browser (default: host part of SSH_TARGET)
SERVER_HOST=203.0.113.10
